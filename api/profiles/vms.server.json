{
 "id": "vms.server/1",
 "version": "1.1",
 "label": "Сервер",
 "owner": "mockup",
 "reviewers": [
  "w2c"
 ],
 "uses": [
  {
   "id": "vms.archive/1",
   "version": "1.0"
  },
  {
   "id": "vms.edge/1",
   "version": "1.0"
  },
  {
   "id": "vms.webserver/1",
   "version": "1.0"
  }
 ],
 "properties": {
  "allocated": {
   "schema": {
    "type": "boolean",
    "readOnly": true
   },
   "meaning": "«Распределён»: False — сервер найден в сети домена, но ещё не добавлен («Нераспределённые») (только чтение)",
   "since": "1.0"
  },
  "dns": {
   "schema": {
    "type": "string"
   },
   "meaning": "DNS",
   "since": "1.0",
   "absent": "unsupported"
  },
  "gateway": {
   "schema": {
    "type": "string"
   },
   "meaning": "Шлюз",
   "since": "1.0",
   "absent": "unsupported"
  },
  "ip": {
   "schema": {
    "type": "string"
   },
   "meaning": "«IP»",
   "since": "1.0",
   "absent": "unsupported"
  },
  "labels": {
   "schema": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "meaning": "Метки сервера: по ним размещаются камеры, детекторы, записи, правила",
   "since": "1.0"
  },
  "netmask": {
   "schema": {
    "type": "string"
   },
   "meaning": "Маска сети",
   "since": "1.0",
   "absent": "unsupported"
  },
  "port": {
   "schema": {
    "type": "integer"
   },
   "meaning": "«Порт»",
   "since": "1.0",
   "absent": "unsupported"
  },
  "role": {
   "schema": {
    "type": "string",
    "enum": [
     "primary",
     "node",
     "standby"
    ]
   },
   "meaning": "«Роль»: Основной, узел, резервный",
   "since": "1.0",
   "absent": "unsupported"
  }
 },
 "status": {
  "class": {
   "schema": {
    "type": "string",
    "enum": [
     "server",
     "camera"
    ]
   },
   "meaning": "чем представился стучащийся в домен: сервер или камера; человек подтверждает это при приёме",
   "since": "1.0"
  },
  "disks": {
   "schema": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "disk": {
       "type": "string"
      },
      "sizeBytes": {
       "type": "integer"
      },
      "system": {
       "type": "boolean"
      }
     }
    }
   },
   "meaning": "диски сервера: на них ставятся тома локальных хранилищ",
   "since": "1.0"
  },
  "fingerprint": {
   "schema": {
    "type": "string"
   },
   "meaning": "отпечаток стучащегося сервера: администратор сверяет его перед приёмом (`move` с `params.fingerprint`)",
   "since": "1.0"
  },
  "gpu": {
   "schema": {
    "type": [
     "object",
     "null"
    ],
    "properties": {
     "model": {
      "type": "string"
     },
     "memoryBytes": {
      "type": "integer"
     },
     "load": {
      "type": "number"
     }
    }
   },
   "meaning": "видеокарта сервера: для серверных детекторов, метка `gpu`",
   "since": "1.0",
   "absent": "unsupported"
  },
  "telemetry": {
   "schema": {
    "type": "object",
    "properties": {
     "cpu": {
      "type": "number"
     },
     "ram": {
      "type": "number"
     },
     "net": {
      "type": "number"
     },
     "disk": {
      "type": "number"
     }
    }
   },
   "meaning": "нагрузка сервера: процессор, память, сеть, диск",
   "since": "1.0",
   "absent": "unsupported"
  }
 },
 "changes": [
  {
   "version": "1.1",
   "what": "Запрос 154325Z, ответ w2c, п. 3 и 3.1: `absent: unsupported` у полей, которых у w2c нет: ip, port, role, dns, gateway, netmask, telemetry, gpu. Нет значения — у сервера нет такой возможности: особый экран прячет поле, если его нельзя править. Поля и типы не менялись"
  },
  {
   "version": "1.0",
   "what": "Профиль перенесён в файл из api/fixtures/demo.json и api/BACKEND.md, контракт 0.25.0. Поля до переноса — с 1.0; когда какое поле появилось в контракте — api/README.md, «Что добавлено в …»"
  }
 ]
}
